# Copy to .env.local for development (Next.js loads it automatically).

# MongoDB: LOCAL_DB_URI is used in development, CLOUD_DB_URI in production
LOCAL_DB_URI=
CLOUD_DB_URI=

# JWT secrets
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
JWT_SECRET=

# Public site URL, used in referral and password-reset links (e.g. https://algotrades.io)
CLIENT_URL=

# Cloudinary (profile photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET_KEY=

# SMTP for email notifications (defaults: smtp.hostinger.com:465)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
# Optional: sender shown on emails (default "Admin <MAIL_USER>") and where admin alerts go
MAIL_FROM=
ADMIN_EMAIL=

# Set to "false" to stop the built-in daily profit scheduler (Agenda)
ENABLE_PROFIT_SCHEDULER=

# Optional: point the frontend at a different API (defaults to same-origin /api/v1/)
NEXT_PUBLIC_API_URL=
